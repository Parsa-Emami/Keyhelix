    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "time",
          "subject",
          "data"
        ],
        "properties": {
          "specversion": {
            "type": "string",
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 16
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "secret.version_created.v1",
              "secret.revealed.v1",
              "grant.created.v1",
              "grant.revoked.v1",
              "key.rotation_started.v1",
              "key.envelope_rewrapped.v1",
              "key.rotation_completed.v1",
              "audit.checkpoint_signed.v1"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
