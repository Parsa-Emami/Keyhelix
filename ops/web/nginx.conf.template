# Complete KeyHelix release: the supervised web/engine pair exposes one loopback
# listener on 4305. The engine gets an ephemeral loopback address inside the
# service and must never be proxied or published directly.
#
# Replace every __PLACEHOLDER__, run nginx -t, then enable the site.
# All external traffic is denied until reviewed trusted CIDRs are explicitly added.
server {
    listen 443 ssl;
    server_name __OWNED_DOMAIN__;
    server_tokens off;
    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    allow 127.0.0.1;
    allow ::1;
    # allow __TRUSTED_OPERATOR_CIDR__;
    deny all;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:4305;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 20s;
    }
}
