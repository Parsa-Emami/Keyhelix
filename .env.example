# Safe local placeholders only. Copy to .env locally; never commit .env or real credentials.
APP_ENV=local
SERVICE_NAME=keyhelix
DATABASE_DSN_REF=secret://local/postgres-dsn
VALKEY_DSN_REF=secret://local/valkey-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LOG_LEVEL=info
OPENBAO_ADDR=https://openbao.local:8200
OPENBAO_TOKEN_REF=secret://local/openbao-token
OPENBAO_KEK_MOUNT=transit
OBJECT_STORE_ENDPOINT=https://object-store.local
OBJECT_STORE_BUCKET=keyhelix-audit
SECRET_PLAINTEXT_LOGGING=forbidden
