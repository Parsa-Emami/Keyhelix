{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyHelix result planning draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "unverified"
      ]
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine_version": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "input_digest",
    "engine_version",
    "result",
    "warnings"
  ]
}
