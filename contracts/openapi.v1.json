          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "vault_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "principal_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "vault_id",
                  "principal_id",
                  "permissions",
                  "expires_at"
                ]
