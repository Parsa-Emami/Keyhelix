    "/audit/checkpoints/{id}/verify": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": "Opaque resource identifier."
        }
      ],
      "get": {
        "summary": "Verify signed audit checkpoint",
        "operationId": "keyhelix_get_audit_checkpoints_id_verify",
