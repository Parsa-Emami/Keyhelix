{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:keyhelix:input:1",
  "title": "KeyHelix v1 local secret-metadata validation input",
  "$comment": "The Go decoder additionally enforces <=8192 UTF-8 input bytes, no duplicate keys or trailing data, and exact numeric values; validation is not authentication, storage persistence or provider custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "secret_id",
    "secret_path",
    "version",
    "classification",
    "created_at",
    "envelope"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "vault_id": {
      "$ref": "#/$defs/identifier"
    },
    "secret_id": {
      "$ref": "#/$defs/identifier"
    },
    "secret_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "classification": {
      "type": "string",
      "enum": [
        "restricted",
        "confidential",
        "internal"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "wrapped_dek",
        "nonce",
        "tag",
        "kek_id"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "AES-256-GCM"
        },
        "wrapped_dek": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "kek_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
